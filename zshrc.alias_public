alias where="command -v"
alias tmux='tmux -2'
alias vi='nvim'
alias vim='nvim'
alias be='bundle exec'
alias gs='git status'
alias gst='git stash -u'
alias gdh='git diff HEAD'
alias gbdm='git branch -d `git branch --merged | grep -v \* | grep -v master | grep -v develop`'
alias gbc='git pull; gbdm; git fetch -p'
alias gitrepocleanup='gcd;gst;gbc'
alias gcmt='git commit -m'
alias gitopenremote="open \`git remote get-url origin | sed -Ee 's#(ssh://)?(git@|git://)#http://#' -e 's@com:@com/@'\`"
alias pwgitdir='gitdir_or_currentdir'
alias gcd='cd `pwgitdir`'
alias gadd='git add `pwgitdir`'
alias ghb='gh browse'
alias od='OVERCOMMIT_DISABLE=1'
alias top='top -ocpu'
alias ssh='if ! ssh-add -l >& /dev/null ; then ssh-add -t 12h ; fi ; ssh'
alias clip="tr -d '\n' | pbcopy && pbpaste"
alias mv='mv -i'
alias cp='cp -i'
alias ports='lsof -i -P | grep "LISTEN"'
alias dc='docker compose --project-directory=`pwgitdir`'
alias dcr='dc run --rm'
alias dce='dc exec'
alias dcu='dc up'
alias oc='OPEN_CHROME=1'
alias python='python3'
alias ds='DISABLE_SPRING=1'
alias donealert="afplay /System/Library/Sounds/Glass.aiff > /dev/null & disown && osascript -e 'display alert \"done\"' > /dev/null & disown"
alias ce='cursor .'

# functions

function bool {
  eval "
  if [[ $@ ]] ; then
    echo 'true'
  else
    echo 'false'
  fi
  "
}

function sortdiff {
  diff <(sort $1) <(sort $2)
}

function gitdir_or_currentdir {
  git status > /dev/null 2>&1
  if [[ $? -eq 0 ]]; then
    git rev-parse --show-toplevel
  else
    echo -n '.'
  fi
}
